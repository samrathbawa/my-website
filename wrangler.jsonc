{
	"name": "my-website",
	"main": "src/worker.js",
	"compatibility_date": "2026-07-03",
	// Static files win; anything unmatched (upload ids) falls through to the worker.
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": [
			"/api/*"
		]
	},
	// Upload key is a secret: `npx wrangler secret put UPLOAD_KEY`
	"r2_buckets": [
		{
			"binding": "UPLOADS",
			"bucket_name": "sambawa-uploads"
		}
	],
	"routes": [{ "pattern": "sambawa.dev", "custom_domain": true }],
	// Daily: delete uploads older than 180 days unless marked "keep" (see purgeExpired)
	"triggers": {
		"crons": [
			"17 9 * * *"
		]
	}
}